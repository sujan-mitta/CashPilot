generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id           String        @id @default(cuid())
  name         String
  currentCash  Int           // Stored in paise/cents to avoid float errors
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  invoices     Invoice[]
  payouts      Payout[]
  forecasts    CashForecast[]
  strategies   Strategy[]
  users        User[]
  decisions    Decision[]
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

model Transaction {
  id               String            @id @default(cuid())
  business         Business          @relation(fields: [businessId], references: [id])
  businessId       String
  amount           Int               // in paise
  type             TransactionType
  status           TransactionStatus
  description      String?
  expectedDate     DateTime
  paymentRecovery  PaymentRecovery?
  createdAt        DateTime          @default(now())

  @@index([businessId])
}

enum InvoiceStatus {
  PAID
  OVERDUE
  PENDING
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Invoice {
  id           String        @id @default(cuid())
  business     Business      @relation(fields: [businessId], references: [id])
  businessId   String
  customerName String
  amount       Int           // in paise
  dueDate      DateTime
  status       InvoiceStatus
  priority     Priority

  @@index([businessId])
}

enum PayoutCriticality {
  HIGH
  MEDIUM
  LOW
}

enum PayoutStatus {
  SCHEDULED
  PAID
  RESCHEDULED
  PAUSED
}

model Payout {
  id            String             @id @default(cuid())
  business      Business           @relation(fields: [businessId], references: [id])
  businessId    String
  vendor        String
  amount        Int                // in paise
  scheduledDate DateTime
  criticality   PayoutCriticality
  status        PayoutStatus       @default(SCHEDULED)

  @@index([businessId])
}

model CashForecast {
  id               String    @id @default(cuid())
  business         Business  @relation(fields: [businessId], references: [id])
  businessId       String
  date             DateTime
  openingBalance   Int
  expectedInflows  Int
  expectedOutflows Int
  projectedBalance Int
  createdAt        DateTime  @default(now())

  @@index([businessId])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RecoveryStatus {
  RECOVERY_CANDIDATE
  RECOVERY_INITIATED
  PAYMENT_LINK_CREATED
  PAYMENT_PENDING
  RECOVERED
  EXPIRED
  FAILED
}

model PaymentRecovery {
  id            String         @id @default(cuid())
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
  transactionId String         @unique
  status        RecoveryStatus @default(RECOVERY_CANDIDATE)
  paymentLinkId String?        // Razorpay payment link ID
  shortUrl      String?        // Razorpay payment link URL
  amount        Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Strategy {
  id               String        @id @default(cuid())
  business         Business      @relation(fields: [businessId], references: [id])
  businessId       String
  name             String        // "DO_NOTHING" | "RECOVER_ONLY" | "RECOVER_AND_COLLECT" | "FULL_INTERVENTION"
  actions          Json          // Array of ActionDefinition
  projectedBalance Int
  riskLevel        RiskLevel
  score            Float
  recommended      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  agentActions     AgentAction[]
  actualOutcome    Json?         // Stores { actualBalance: Int, actualDeficitDays: Int, actualCoverage: Float, error: Json }
  startingCash     Int           @default(0)
  scoring          Json?
  decision         Decision?

  @@index([businessId])
}

enum ActionType {
  RECOVER_FAILED_PAYMENTS
  PRIORITIZE_COLLECTIONS
  RESCHEDULE_PAYOUT
  PAUSE_EXPENSE
}

enum ActionStatus {
  PENDING
  APPROVED
  EXECUTING
  COMPLETED
  FAILED
  REJECTED
  STALE
  EXECUTION_REQUESTED
  EXECUTION_UNKNOWN
  EXECUTED
  RECONCILING
  RECONCILIATION_FAILED
  RECONCILIATION_MISMATCH
}

/// Durable record of the INTENT to perform an external financial operation.
///
/// Phase 15 P0. A database transaction cannot make a Razorpay API call atomic,
/// so the intent is committed BEFORE the side effect. Crash semantics:
///   RECORDED    - committed, no external effect yet  -> safe to dispatch
///   DISPATCHING - external call in flight            -> NEVER auto-redispatch
///   SUCCEEDED / FAILED / UNKNOWN - resolved
/// A crash while DISPATCHING is swept to UNKNOWN and must be reconciled against
/// the provider, never blindly retried.
model ExecutionIntent {
  id             String                @id @default(cuid())
  businessId     String
  strategyId     String
  actionId       String
  action         AgentAction           @relation(fields: [actionId], references: [id])

  /// Stable per (action, target). Never regenerated on retry.
  idempotencyKey String                @unique

  /// Identity of the UNDERLYING FINANCIAL OBLIGATION, e.g. "INVOICE:<id>".
  ///
  /// Deliberately NOT derived from actionId. Actions are disposable - a
  /// regenerated strategy mints new ones - so an action-scoped key silently
  /// stops protecting the obligation the moment a strategy is regenerated.
  /// The obligation outlives every attempt against it, so duplicate protection
  /// must be anchored here.
  obligationKey  String?
  operation      ExecutionOperation
  targetType     String?
  targetId       String?
  amount         Int

  status         ExecutionIntentStatus @default(RECORDED)
  attempts       Int                   @default(0)

  externalRef    String?
  externalStatus String?
  lastError      String?
  unknownReason  String?

  /// ---- Phase 16 ----
  /// The post-condition this operation is expected to leave behind, captured
  /// BEFORE the side effect. Reconciliation compares persisted reality against
  /// this rather than inferring success from a returned value.
  expectedState       Json?
  /// What reconciliation actually observed, for operator display.
  observedState       Json?
  lastReconciledAt    DateTime?
  /// Full ReconciliationResult from the last attempt.
  reconciliationResult Json?
  /// Set ONLY when the system has positive evidence the operation did not
  /// occur. The single gate on any operator retry.
  retrySafe           Boolean   @default(false)

  recordedAt     DateTime              @default(now())
  dispatchedAt   DateTime?
  resolvedAt     DateTime?
  updatedAt      DateTime              @updatedAt

  @@index([businessId])
  @@index([actionId])
  @@index([strategyId])
  @@index([status])
  @@index([status, dispatchedAt])
  @@index([businessId, obligationKey, status])
}

enum ExecutionOperation {
  CREATE_PAYMENT_LINK
  RESCHEDULE_PAYOUT
  PAUSE_EXPENSE
}

enum ExecutionIntentStatus {
  RECORDED
  DISPATCHING
  SUCCEEDED
  FAILED
  UNKNOWN
}

model AgentAction {
  id                  String       @id @default(cuid())
  strategy            Strategy     @relation(fields: [strategyId], references: [id])
  strategyId          String
  actionType          ActionType
  amount              Int
  status              ActionStatus @default(PENDING)
  result              String?
  targetTransactionId String?
  targetPayoutId      String?
  createdAt           DateTime     @default(now())
  
  executionIntents    ExecutionIntent[]

  predictionActual    Json?        // Stores { prediction: ScoredStrategy["scoring"], actual: ScoredStrategy["scoring"] or similar, error: any }
  auditLog            Json?        // Stores array of AuditEntry { who: string, what: string, when: DateTime, why: string, result: string }

  @@index([strategyId])
  @@index([targetTransactionId])
  @@index([targetPayoutId])
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String
  password   String     @default("mock-password-hash")
  createdAt  DateTime   @default(now())
  businesses Business[]
}

model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

enum DecisionStatus {
  GENERATED
  PRESENTED
  APPROVED
  REJECTED
  EXECUTED
  NOT_EXECUTED
  RECONCILED
  NOT_RECONCILED
  RECONCILIATION_MISMATCH
  OUTCOME_MEASURED
}

model Decision {
  id                     String         @id @default(cuid())
  businessId             String
  business               Business       @relation(fields: [businessId], references: [id])
  strategyId             String         @unique
  strategy               Strategy       @relation(fields: [strategyId], references: [id])
  createdAt              DateTime       @default(now())
  status                 DecisionStatus @default(GENERATED)
  
  engineVersion          String         @default("13.0.0")
  
  baselineSnapshot       Json
  recommendedSnapshot    Json
  approvalSnapshot       Json?
  executionSnapshot      Json?
  reconciliationSnapshot Json?
  
  actualOutcome          Json?
  outcomeMeasuredAt      DateTime?

  /// ---- Phase 15 ----

  /// Deterministic hash of the financial facts the recommendation rests on.
  /// Recomputed at approval/execution and compared; a material difference makes
  /// the strategy STALE. Write-once, like every other historical field.
  contextFingerprint     String?
  /// Per-component hashes + raw values, so a diff can say WHAT changed.
  fingerprintDetail      Json?

  /// The exact critical obligations this recommendation was meant to protect,
  /// with stable identity. Replaces aggregate-count-only storage so actual
  /// protection can be derived from evidence rather than copied from prediction.
  obligationSnapshot     Json?

  /// Outcome measurement runs on its own clock. The forecast horizon stays 14
  /// days; the outcome horizon extends to cover deferred obligations.
  outcomeMeasurementHorizonDays Int          @default(14)
  outcomePhase           OutcomePhase        @default(NOT_STARTED)
  finalOutcomeMeasuredAt DateTime?

  /// Configuration identity at decision time (PART 27).
  scoringConfigVersion   String              @default("14.0.0")
  liquidityConfigVersion String              @default("14.0.0")
  outcomeRulesVersion    String              @default("14.0.0")

  events                 DecisionEvent[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([outcomePhase])
}

/// Outcome measurement lifecycle. Deliberately separate from DecisionStatus:
/// "what did we decide" and "how far has measurement got" are different facts,
/// and Phase 14 established one authoritative state per concept.
enum OutcomePhase {
  NOT_STARTED
  WINDOW_OPEN
  WINDOW_COMPLETE
  POST_HORIZON_PENDING
  FINAL_MEASURED
  UNRESOLVED_AFTER_WINDOW
}

enum DecisionEventType {
  GENERATED
  PRESENTED
  APPROVED
  REJECTED
  STALE_BLOCKED
  EXECUTION_STARTED
  EXECUTION_UNKNOWN
  EXECUTED
  NOT_EXECUTED
  RECONCILED
  NOT_RECONCILED
  RECONCILIATION_MISMATCH
  OUTCOME_MEASURED
  POST_HORIZON_PENDING
  FINAL_OUTCOME_MEASURED
}

/// Append-only audit trail. Rows are never updated or deleted; the event is
/// written in the SAME transaction as the status change it describes, so state
/// and audit history can never disagree.
model DecisionEvent {
  id         String            @id @default(cuid())
  decisionId String
  decision   Decision          @relation(fields: [decisionId], references: [id])
  businessId String
  eventType  DecisionEventType
  fromStatus DecisionStatus?
  toStatus   DecisionStatus?
  /// HUMAN | SYSTEM | WEBHOOK
  actorType  String
  actorId    String?
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([decisionId, createdAt])
  @@index([businessId, createdAt])
  @@index([eventType])
}

/// Lifecycle of ONE inbound webhook delivery.
///
/// Deliberately not merged into ProcessedEvent: that model is the idempotency
/// mechanism and holds exactly one row per event id, created before processing
/// and DELETED again if processing throws. That release is correct - it stops a
/// transient failure from permanently marking a real payment as handled - but it
/// means a delivered-then-failed webhook left no trace anywhere (M1).
enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSING
  SUCCEEDED
  FAILED
  DUPLICATE
}

/// Durable observability for inbound webhooks. Never authoritative for money.
///
/// One row per DELIVERY, not per event, so retries and duplicates are all
/// visible. providerEventId is intentionally NOT unique for that reason.
///
/// Holds no secret, no signature and no raw payload - only the identifiers
/// needed to correlate a delivery with what it settled.
model WebhookDeliveryAttempt {
  id                    String                @id @default(cuid())
  provider              String                @default("razorpay")
  /// Null when the request was rejected before the body could be trusted.
  providerEventId       String?
  eventType             String?
  status                WebhookDeliveryStatus
  attemptNumber         Int                   @default(1)
  receivedAt            DateTime              @default(now())
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  /// Stable classification, e.g. INVALID_SIGNATURE, MISSING_SIGNATURE.
  errorClass            String?
  /// Our own truncated error text. Never provider credentials or headers.
  errorMessage          String?
  correlationId         String?
  businessId            String?
  executionIntentId     String?
  externalRef           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([providerEventId])
  @@index([status])
  @@index([businessId])
}

/// Phase 1 - the canonical, append-only spine of the Unified Financial Brain.
///
/// Every source (bank, ERP, invoices, Razorpay, email, user) will eventually
/// normalise its raw records into FinancialEvents. This is deliberately NOT
/// authoritative on its own: it is the evidence spine that later phases attach
/// Evidence / Claims / unified state to. In Phase 1 it has NO consumers - it is
/// written to but nothing reads it - so it cannot change any existing behaviour.
///
/// Idempotency: (businessId, sourceType, sourceRecordId) is the stable source
/// identity. Re-delivering the same source record - webhook retry, re-sync, a
/// restart mid-batch - must never create a duplicate event. Follows the newer
/// convention (ExecutionIntent, WebhookDeliveryAttempt) of a bare businessId
/// column with an index rather than a Prisma relation, so tenancy is enforced
/// in queries and this table stays fully isolated from existing models.
model FinancialEvent {
  id             String             @id @default(cuid())
  businessId     String

  eventType      FinancialEventType
  /// The originating source, e.g. "RAZORPAY", "BANK", "ERP", "INVOICE",
  /// "USER", "SEED". A plain string so a new source needs no enum migration.
  sourceType     String
  /// Stable identifier of the underlying record AT THE SOURCE.
  sourceRecordId String

  /// Canonical entity (Customer / Supplier) once entity resolution lands (P4).
  /// Null in Phase 1.
  entityId       String?

  /// In paise, like every amount in this system. Null for events that carry no
  /// monetary value.
  amount         Int?
  currency       String             @default("INR")

  /// When the event occurred at the source.
  occurredAt     DateTime
  /// When it takes financial effect (defaults to occurredAt at write time).
  effectiveAt    DateTime

  /// Source-specific lifecycle status, kept as a string for extensibility.
  status         String?

  /// Structured, normalised payload. MUST NOT contain secrets, credentials,
  /// signatures or raw provider headers.
  normalizedData Json?
  /// A non-sensitive pointer back to the raw record (e.g. an internal row id).
  rawReference   String?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([businessId, sourceType, sourceRecordId])
  @@index([businessId])
  @@index([businessId, effectiveAt])
  @@index([businessId, entityId])
  @@index([eventType])
}

enum FinancialEventType {
  INVOICE_CREATED
  INVOICE_DUE
  INVOICE_OVERDUE
  INVOICE_PAID
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYOUT_SCHEDULED
  PAYOUT_SETTLED
  PAYOUT_RESCHEDULED
  PAYOUT_PAUSED
  BANK_TRANSACTION
  SETTLEMENT
  USER_ADJUSTMENT
}

/// Phase 2 - a CLAIM is an assertion about a financial fact, e.g. "invoice X is
/// contractually due on Sep 5" or "money for invoice X actually arrived". It is
/// deliberately typed (ClaimType) so a prediction is never stored as a fact
/// (spec §13). One claim per (subject, claimType); its supporting evidence is
/// append-only and may accumulate (spec §46).
///
/// A claim's `confidence` is derived from its evidence. In Phase 2 that is a
/// provisional stand-in; the real multi-dimensional formula lands in Phase 3.
model Claim {
  id          String     @id @default(cuid())
  businessId  String

  claimType   ClaimType
  /// What the claim is about: "INVOICE" | "PAYOUT" | "TRANSACTION" | ...
  subjectType String
  /// Stable id of the subject at its source (e.g. an Invoice id).
  subjectId   String

  /// The asserted fact, structured (e.g. { dueDate, amount }).
  assertion   Json
  /// Monetary value in paise, if the claim is about money.
  amount      Int?
  currency    String     @default("INR")
  /// When the claim is expected to hold / take effect.
  effectiveAt DateTime?

  /// Aggregate confidence in [0,1] derived from supporting evidence.
  confidence  Float      @default(0)
  /// ACTIVE | SUPERSEDED | EXPIRED - claims are re-resolvable; evidence is not.
  status      String     @default("ACTIVE")

  evidence    Evidence[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([businessId, subjectType, subjectId, claimType])
  @@index([businessId])
  @@index([businessId, subjectType, subjectId])
  @@index([businessId, claimType])
}

/// Phase 2 - EVIDENCE is one observation supporting a claim, from one source.
///
/// Append-only (spec §46): when a customer says "I'll pay Sep 10" the original
/// contractual-date evidence is NOT overwritten - a new row is added and the
/// claim is re-resolved. The confidence components are multi-dimensional
/// (spec §11); Phase 2 populates only what it can compute honestly and leaves
/// the rest null for Phase 3 rather than manufacturing precision.
model Evidence {
  id             String   @id @default(cuid())
  businessId     String

  claim          Claim    @relation(fields: [claimId], references: [id])
  claimId        String

  /// Originating source, e.g. "ERP", "BANK", "RAZORPAY", "USER", "HISTORICAL".
  sourceType     String
  /// Stable id of the record at the source.
  sourceRecordId String
  /// Optional link to the canonical FinancialEvent once events exist (P1 spine).
  financialEventId String?

  /// A finer classification, e.g. "ERP_INVOICE", "BANK_TRANSACTION".
  evidenceType   String

  observedAt     DateTime
  effectiveAt    DateTime?

  /// Confidence components in [0,1]. Only the honestly-computable ones are set
  /// in Phase 2; specificity/historicalAccuracy/consistency arrive in P3/P9.
  reliabilityScore        Float?
  freshnessScore          Float?
  specificityScore        Float?
  historicalAccuracyScore Float?
  consistencyScore        Float?
  derivedConfidence       Float?

  metadata       Json?
  createdAt      DateTime @default(now())

  @@unique([businessId, claimId, sourceType, sourceRecordId, evidenceType])
  @@index([businessId])
  @@index([claimId])
  @@index([businessId, sourceType, sourceRecordId])
}

enum ClaimType {
  ACTUAL
  CONFIRMED
  CONTRACTUAL
  EXPECTED
  PREDICTED
  UNCERTAIN
  CONTRADICTED
  EXPIRED
  RECONCILED
}
